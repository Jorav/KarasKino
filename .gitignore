## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio
.vs/

# VS Code
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Dd]ebugPS/
[Rr]eleasePS/

# .NET
artifacts/
project.lock.json
project.fragment.lock.json

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Publish
publish/
*.pubxml
*.publishproj
*.azurePubxml
PublishScripts/

# ASP.NET Core
**/Properties/launchSettings.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.cache
*.pidb
*.pdb
*.ilk
*.obj

# SQL Server
*.mdf
*.ldf

# Node.js / Angular
node_modules/
.angular/
dist/
coverage/
typings/

# Aspire
.aspire/

# Environment files
.env
.env.*

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# Visual Studio cache
*.VC.db
*.VC.VC.opendb
*.opendb
*.opensdf
*.sdf
ipch/

# Misc
.DS_Store
Thumbs.db
~$*
*~

# Python
__pycache__/
*.pyc

# Generated packages
*.nupkg

# Secrets
/secrets/local.secrets.json
