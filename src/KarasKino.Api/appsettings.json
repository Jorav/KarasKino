{
  "ConnectionStrings": {
    // Used when running without Aspire - requires a local Postgres instance
    "DefaultConnection": "Host=localhost;Port=5432;Database=karaskinodb;Username=postgres;Password=postgres"
  },
  "Database": {
    // Set to true to apply migrations on startup (useful for containerized/production environments)
    // In Development, migrations run automatically regardless of this setting
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Mailserver": {
    "Server": "localhost",
    "Port": 25
  }
}